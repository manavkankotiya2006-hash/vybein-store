---
import Crest from "./Crest.astro";
import { PRODUCTS, STORE, productUrl, whatsappLink } from "../data/products";
---
<footer class="footer">
  <div class="container">
    <div class="footer-crest">
      <Crest />
      <p class="eyebrow">Maison de parfum · Made in India</p>
      <p class="footer-word" aria-hidden="true">VYBEIN</p>
    </div>
    <div class="footer-grid">
      <div>
        <h4>The collection</h4>
        {PRODUCTS.slice(0, 4).map((product) => <a href={productUrl(product)}>{product.code} · {product.inspiredBy}</a>)}
        <a href="/shop">All eight signatures</a>
      </div>
      <div>
        <h4>The maison</h4>
        <a href="/about">Our story</a>
        <a href="/contact">Contact &amp; questions</a>
        <a href="/cart">Your bag</a>
      </div>
      <div>
        <h4>Write to us</h4>
        <a href={whatsappLink("Hi VYBEIN, help me find a fragrance.")} target="_blank" rel="noopener">WhatsApp · {STORE.whatsappDisplay}</a>
        <a href={`tel:+${STORE.whatsappNumber}`}>Call · {STORE.whatsappDisplay}</a>
        <a href={STORE.instagram} target="_blank" rel="noopener">Instagram · {STORE.instagramHandle}</a>
      </div>
    </div>
    <div class="footer-base">
      <span>© {new Date().getFullYear()} VYBEIN</span>
      <span>Made for your point of view</span>
    </div>
  </div>
</footer>
<a class="whatsapp-float" href={whatsappLink("Hi VYBEIN, I have a question.")} target="_blank" rel="noopener" aria-label="Chat with VYBEIN on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.82 9.82 0 0 0-8.48 14.8L2 22l5.34-1.4A9.95 9.95 0 1 0 12.04 2Zm0 17.94a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.17.83.84-3.08-.2-.32a8.12 8.12 0 1 1 6.96 3.88Zm4.45-6.08c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.23-.62.77-.76.93-.14.15-.28.17-.52.05-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.4-1.33-1.64-.14-.23-.02-.36.1-.48.1-.1.24-.27.36-.4.12-.14.16-.24.24-.4.08-.15.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.4h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.31.98 2.47c.12.15 1.69 2.58 4.09 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.58 1.63-1.14.2-.55.2-1.03.14-1.13-.06-.1-.22-.16-.46-.28Z" /></svg>
</a>
