---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Crest from "../components/Crest.astro";
import { STORE } from "../data/products";
import { formatPrice } from "../lib/pricing";
import aboutImage from "../assets/about-perfume-lab.png";

const values = [
  ["Follow your mood", "Pick the scent that fits how you feel, and let it become part of your day."],
  ["Make it a ritual", "A small moment, a familiar note, a new memory. Let fragrance be yours."],
  ["Keep it within reach", `Every extrait in the collection is ${formatPrice(STORE.price)}, reduced from ${formatPrice(STORE.originalPrice)}.`]
];
const faqs = [
  ["Are VYBEIN fragrances unisex?", "Yes. The collection is made for anyone who likes the way a scent feels."],
  ["How do I place an order?", "Add your extraits to the bag and continue on WhatsApp. We confirm the order there and share our UPI QR code for payment."],
  ["How do I find the right scent?", "Explore the notes on each perfume, try the scent finder on our home page, or message us on WhatsApp and tell us what you enjoy."]
];
---
<Base title="The Maison — Our Story | VYBEIN" description="Meet VYBEIN, a modern maison de parfum built on one idea: wear what feels like you.">
  <section class="about-hero on-noir">
    <div class="container about-grid">
      <div class="about-copy">
        <span class="roman" data-enter>The maison</span>
        <h1 class="display" data-enter="rise" style="--delay:0.08s">Wear the<br /><em>feeling.</em></h1>
        <p class="lede" data-enter style="--delay:0.16s">A first impression, a private ritual, or a feeling you cannot quite put into words. However you wear it, it should feel like you.</p>
        <a class="btn btn-gold" href="/shop" data-enter style="--delay:0.24s">Find your extrait <Arrow /></a>
      </div>
      <div class="about-art arch arch-lined" data-enter>
        <Picture src={aboutImage} formats={["avif"]} fallbackFormat="webp" widths={[480, 760, 1100]} sizes="(max-width: 900px) 88vw, 42vw" alt="A perfumer adding amber essence to a VYBEIN bottle at a workbench" loading="eager" />
      </div>
    </div>
  </section>

  <section class="statement on-burgundy">
    <div class="container statement-inner">
      <Crest class="statement-crest" />
      <h2 class="title" data-reveal="rise">Choose by feeling.<br /><em>Wear with intention.</em></h2>
      <p class="lede" data-reveal>VYBEIN creates inspired recreations of iconic perfume profiles. Each extrait is composed to feel 97.8% similar to its inspiration, with {STORE.concentration} — a familiar character, made personal, for {formatPrice(STORE.price)}.</p>
    </div>
  </section>

  <section class="section on-ivory">
    <div class="container">
      <div class="heading">
        <span class="roman" data-reveal>Made for your point of view</span>
        <h2 class="title" data-reveal="rise">A scent for <em>every side.</em></h2>
        <span class="ornament" data-reveal><i></i></span>
      </div>
      <div class="values">
        {values.map(([title, text], index) => (
          <article data-reveal style={`--delay:${index * 0.12}s`}>
            <span>{["I", "II", "III"][index]}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section on-parchment">
    <div class="container">
      <div class="heading">
        <span class="roman" data-reveal>A few quiet notes</span>
        <h2 class="title" data-reveal="rise">Good to <em>know.</em></h2>
      </div>
      <div class="faq" data-reveal>
        {faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero { padding: calc(var(--header) + 34px + clamp(48px, 7vw, 96px)) 0 clamp(80px, 10vw, 140px); background: radial-gradient(ellipse at 85% 10%, rgba(90, 20, 36, .5), transparent 55%), var(--noir); }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: clamp(48px, 7vw, 112px); align-items: center; }
  .about-copy { display: grid; justify-items: start; gap: 24px; }
  .about-art { aspect-ratio: 4 / 5; background: var(--umber); }
  .about-art img { width: 100%; height: 100%; object-fit: cover; }
  .statement { padding-block: clamp(96px, 12vw, 168px); text-align: center; background: radial-gradient(ellipse at 50% 0%, #6a1a2c 0%, var(--burgundy) 30%, var(--burgundy-deep) 75%); }
  .statement-inner { display: grid; justify-items: center; gap: 28px; }
  .statement-inner :global(.statement-crest) { width: 72px; color: var(--gold); }
  .statement .lede { max-width: 40rem; text-align: center; color: #cdb9b1; }
  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 56px); }
  .values article { display: grid; gap: 14px; padding-top: 28px; border-top: 1px solid rgba(143, 110, 53, .35); }
  .values span { font-family: var(--serif); font-size: 2.6rem; font-weight: 300; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--gold-deep); }
  .values h3 { font-size: 1.9rem; }
  .values p { color: var(--muted-light); }
  @media (max-width: 900px) {
    .about-grid, .values { grid-template-columns: 1fr; }
    .about-copy { justify-items: center; text-align: center; }
    .about-copy .lede { text-align: center; }
    .about-art { width: min(100%, 440px); margin-inline: auto; }
  }
</style>
