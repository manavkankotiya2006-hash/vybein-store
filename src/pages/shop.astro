---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Arrow from "../components/Arrow.astro";
import Muse from "../components/Muse.astro";
import { PRODUCTS, SHOP_FILTERS, STORE, whatsappLink } from "../data/products";
import { formatPrice, offerIsLive } from "../lib/pricing";
---
<Base
  title="The Collection — Eight Extraits de Parfum | VYBEIN"
  description={`Explore all eight VYBEIN unisex extraits de parfum. Each ${formatPrice(STORE.price)}, reduced from ${formatPrice(STORE.originalPrice)}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="roman" data-enter>The collection</span>
      <h1 class="display" data-enter="rise" style="--delay:0.08s">Eight <em>signatures.</em></h1>
      <p class="lede" data-enter style="--delay:0.16s">Fresh, warm, woody or spiced — each extrait carries {STORE.concentration}, and each is {formatPrice(STORE.price)}.</p>
      {offerIsLive() && <p class="shop-festive" data-diwali-banner data-enter style="--delay:0.24s"><span>Diwali Edition</span> Choose any three — the third is our gift.</p>}
    </div>
  </section>

  <section class="section on-ivory shop">
    <div class="container">
      <div class="toolbar">
        <div class="filters" role="group" aria-label="Filter by fragrance family">
          {SHOP_FILTERS.map((filter, index) => (
            <button type="button" data-filter={filter.key} data-terms={filter.terms.join(",")} aria-pressed={index === 0 ? "true" : "false"}>{filter.label}</button>
          ))}
        </div>
        <p class="count" aria-live="polite" data-count>{PRODUCTS.length} extraits</p>
      </div>
      <div class="collection-grid" data-grid>
        {PRODUCTS.map((product, index) => <ProductCard product={product} delay={(index % 4) * 0.08} eager={index < 4} />)}
      </div>
    </div>
  </section>

  <section class="muse-section on-noir" data-reveal="fade">
    <div class="container"><Muse variant="band" /></div>
  </section>

  <section class="consult on-burgundy">
    <div class="container consult-inner">
      <span class="roman" data-reveal>A private consultation</span>
      <h2 class="title" data-reveal="rise">Not sure where <em>to begin?</em></h2>
      <p class="lede" data-reveal>Tell us the scents you already love. We will suggest the extrait that suits you best.</p>
      <a class="btn btn-ghost" href={whatsappLink("Hi VYBEIN, can you help me choose a fragrance? I usually enjoy…")} target="_blank" rel="noopener" data-reveal>Ask us on WhatsApp <Arrow /></a>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-grid] .card");
  const count = document.querySelector<HTMLElement>("[data-count]");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const terms = (button.dataset.terms || "").split(",").filter(Boolean);
      let shown = 0;
      cards.forEach((card) => {
        const visible = !terms.length || terms.some((term) => (card.dataset.category || "").includes(term));
        card.hidden = !visible;
        if (visible) {
          shown++;
          card.classList.add("is-in");
        }
      });
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      if (count) count.textContent = `${shown} ${shown === 1 ? "extrait" : "extraits"}`;
    });
  });
</script>

<style>
  .shop-festive { color: var(--muted-dark); font-size: 13.5px; }
  .shop-festive span { margin-right: 8px; color: var(--gold); font-size: 9.5px; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; }
  .shop { padding-top: clamp(48px, 6vw, 80px); }
  .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: clamp(40px, 5vw, 64px); padding-bottom: 22px; border-bottom: 1px solid var(--line-light); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button { min-height: 40px; padding: 0 20px; border: 1px solid var(--line-light); background: transparent; font-size: 10px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; transition: background-color .4s var(--ease), color .4s var(--ease), border-color .4s var(--ease); }
  .filters button:hover { border-color: var(--gold-deep); }
  .filters button[aria-pressed="true"] { border-color: var(--burgundy); background: var(--burgundy); color: var(--ivory); }
  .count { color: var(--muted-light); font-family: var(--serif); font-style: italic; font-size: 1.15rem; }
  .card[hidden] { display: none; }
  .muse-section { padding-block: clamp(80px, 10vw, 136px); }
  .consult { padding-block: clamp(88px, 11vw, 150px); text-align: center; background: radial-gradient(ellipse at 50% 0%, #6a1a2c 0%, var(--burgundy) 30%, var(--burgundy-deep) 75%); }
  .consult-inner { display: grid; justify-items: center; gap: 22px; }
  .consult .lede { text-align: center; }
</style>
