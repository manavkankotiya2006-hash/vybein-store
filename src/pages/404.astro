---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---
<Base title="Page not found — VYBEIN" description="This page has drifted away, like a top note.">
  <section class="page-hero lost">
    <div class="container">
      <span class="roman">404</span>
      <h1 class="display">Like a top note,<br /><em>it has faded.</em></h1>
      <p class="lede">The page you were looking for is no longer here. The collection is waiting.</p>
      <a class="btn btn-gold" href="/shop">Discover the collection <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 100svh; display: grid; align-items: center; }
</style>
